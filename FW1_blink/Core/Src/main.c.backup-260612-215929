#define UPDATE_MAGIC    0xDEADBEEF12345678ULL

/* Phase-1: we don't know the staged image's exact size, so copy a
 * generous fixed amount. Small blink firmwares are well under this. */
#define PHASE1_COPY_SIZE  (64UL * 1024UL)
