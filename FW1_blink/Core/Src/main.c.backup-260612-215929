/* ---------------- UART / ESP ---------------- */

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1) {
        if (rx_index < sizeof(rx_buf) - 1)
            rx_buf[rx_index++] = rx_byte;
        HAL_UART_Receive_IT(&huart1, &rx_byte, 1);
    }
}

void ESP_SendCommand(const char *cmd)
{
    memset(rx_buf, 0, sizeof(rx_buf));
    rx_index = 0;
    HAL_UART_Transmit(&huart1, (uint8_t*)cmd, strlen(cmd), 1000);
}

uint8_t ESP_WaitResponse(const char *expect, uint32_t timeout)
{
    uint32_t start = HAL_GetTick();
    while ((HAL_GetTick() - start) < timeout) {
        if (strstr(rx_buf, expect))   return 1;
        if (strstr(rx_buf, "ERROR"))  return 0;
        HAL_Delay(10);
    }
    return 0;
}

void Debug_Print(const char *msg)
{
    HAL_UART_Transmit(&huart2, (uint8_t*)msg, strlen(msg), 1000);
}

/* ---------------- Flash helpers ---------------- */

HAL_StatusTypeDef Flash_EraseRegion(uint32_t addr, uint32_t size)
{
    FLASH_EraseInitTypeDef e = {0};
    uint32_t page_err;
    HAL_StatusTypeDef st = HAL_OK;
    uint32_t cur = addr;
    uint32_t end = addr + size;

    HAL_FLASH_Unlock();
    while (cur < end) {
        if (cur < 0x08080000UL) {
            e.Banks = FLASH_BANK_1;
            e.Page  = (cur - 0x08000000UL) / PAGE_SIZE;
        } else {
            e.Banks = FLASH_BANK_2;
            e.Page  = (cur - 0x08080000UL) / PAGE_SIZE;
        }
        e.TypeErase = FLASH_TYPEERASE_PAGES;
        e.NbPages   = 1;
        st = HAL_FLASHEx_Erase(&e, &page_err);
        if (st != HAL_OK) break;
        cur += PAGE_SIZE;
    }
    HAL_FLASH_Lock();
    return st;
}

/* Write arbitrary bytes (len rounded up to 8 internally) */
HAL_StatusTypeDef Flash_Write(uint32_t addr, const uint8_t *data, uint32_t len)
{
    HAL_StatusTypeDef st = HAL_OK;
    uint64_t dword;

    HAL_FLASH_Unlock();
    for (uint32_t off = 0; off < len; off += 8) {
        memset(&dword, 0xFF, 8);
        uint32_t chunk = (len - off >= 8) ? 8 : (len - off);
        memcpy(&dword, data + off, chunk);
        st = HAL_FLASH_Program(FLASH_TYPEPROGRAM_DOUBLEWORD, addr + off, dword);
        if (st != HAL_OK) break;
    }
    HAL_FLASH_Lock();
    return st;
}

/* Write the "update pending" flag and reboot into the bootloader */
void OTA_MarkUpdatePending(uint32_t image_size)
{
    uint64_t flag[2];
    flag[0] = UPDATE_MAGIC;
    flag[1] = image_size;

    Flash_EraseRegion(FLAG_ADDR, PAGE_SIZE);
    Flash_Write(FLAG_ADDR, (uint8_t*)flag, sizeof(flag));

    Debug_Print("Update flag set - rebooting into bootloader...\r\n");
    HAL_Delay(100);
    NVIC_SystemReset();
}

