int main(void)
{
  /* USER CODE BEGIN 1 */
  /* Vector table lives in the app slot, not at flash start */
  SCB->VTOR = APP_ADDR;
  /* USER CODE END 1 */

  HAL_Init();
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /* USER CODE END SysInit */

  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_USART2_UART_Init();

  /* USER CODE BEGIN 2 */
  HAL_UART_Receive_IT(&huart1, &rx_byte, 1);

  Debug_Print("\r\n=== APP running from 0x08008000 ===\r\n");
#if BLINK_RATE_MS == 2000
  Debug_Print("This is FW1 (slow blink, 2000 ms)\r\n");
#else
  Debug_Print("This is FW2 (fast blink, 500 ms)\r\n");
#endif

#if USE_WIFI
  HAL_Delay(5000);
  ESP_SendCommand("AT\r\n");
  if (ESP_WaitResponse("OK", 2000))
      Debug_Print("AT OK!\r\n");

  ESP_SendCommand("AT+CWMODE=1\r\n");
  ESP_WaitResponse("OK", 2000);

  Debug_Print("Connecting to WING...\r\n");
  ESP_SendCommand("AT+CWJAP=\"WING\",\"asdfghjk\"\r\n");
  if (ESP_WaitResponse("OK", 20000))
      Debug_Print(">>> WIFI CONNECTED <<<\r\n");
  else
      Debug_Print(">>> WIFI FAILED <<<\r\n");
#endif
  /* USER CODE END 2 */

  /* USER CODE BEGIN WHILE */
  while (1)
  {
      /* The blink that identifies which firmware is running */
      HAL_GPIO_TogglePin(GPIOA, GPIO_PIN_5);
      HAL_Delay(BLINK_RATE_MS);

      /* USER button (blue, PC13, active LOW) triggers the update path:
       * marks whatever is in the download slot as pending and reboots */
      if (HAL_GPIO_ReadPin(GPIOC, GPIO_PIN_13) == GPIO_PIN_RESET) {
          Debug_Print("Button pressed - marking update pending\r\n");
          OTA_MarkUpdatePending(PHASE1_COPY_SIZE);
          /* never returns - device resets */
      }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

